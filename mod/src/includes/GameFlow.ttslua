-- The game walk-through on the game controller's screen: after the mission
-- is set up, it shows each step of Setup and of the five rounds (see !/Game)
-- with its rules text, and the buttons to move on. PREV undoes a step, BACK
-- goes to the main menu (Resume Game comes back), and the game is saved with
-- the controller, so a reloaded save carries on at the same step.
--
-- In the Command Phase it reads the command cards flipped face down in the
-- hands and reveals them, works out who chooses priority from their pips,
-- stacks the order tokens and deals the pass pool.
--
-- Included by the game controller: it uses the controller's menu and screen
-- functions (createMenu, printToScreen, change*Button, clearAllButtons), and
-- !/GameTable for what it does on the table.
--
-- Whatever the walk-through does on the table must fail quietly: a piece
-- that isn't where it's expected was most likely moved by the players on
-- purpose, and the game goes on without it.

game = nil

local GAME_TINT = {0, 0.913, 1}
local GAME_SEAT_TINTS = {Blue = {0, 0.4, 1}, Red = {1, 0.2, 0.2}}
local GAME_CHAT_COLOR = {0.8, 0.9, 1}
local GAME_WARN_COLOR = {1, 0.8, 0.4}
-- A click this soon after the buttons are redrawn was aimed at the old ones.
local GAME_REDRAW_GUARD = 0.5

local function gameClickAllowed(playerColor)
  if playerColor == nil or playerColor == "Grey" then return false end
  return os.clock() - (gameDrawnAt or 0) >= GAME_REDRAW_GUARD
end

local function warn(playerColor, text)
  pcall(broadcastToColor, text, playerColor, GAME_WARN_COLOR)
end

-- A seated player can only click for their own seat; an empty seat's
-- buttons are anyone's.
local function mayClickFor(seat, playerColor)
  if Player[seat].seated and playerColor ~= seat then
    warn(playerColor, "Only the " .. seat .. " seat can click that.")
    return false
  end
  return true
end

local function roleName(role)
  return role .. " player"
end

-- "Blue seat (red player)" style, for when seat and role differ.
local function seatName(seat)
  local role = game:roleOf(seat)
  if role == seat then return roleName(role) end
  return seat .. " seat (" .. role:lower() .. " player)"
end

local function plural(count, word)
  return count .. " " .. word .. (count == 1 and "" or "s")
end

-- "No Escape (1 pip)" for a role's played card; nil when none was played.
local function playedText(role)
  local card = game.played[game:seatOf(role)]
  if card == nil then return nil end
  local name = card.name or "a command card"
  return card.pip and (name .. " (" .. plural(card.pip, "pip") .. ")") or name
end

local function cardsText()
  local lines = {}
  for _, role in ipairs({"Blue", "Red"}) do
    table.insert(lines, roleName(role) .. ": " .. (playedText(role) or "no card"))
  end
  return table.concat(lines, "\n")
end

-- The undefeated unit counts by role, and who gets how many Advantage tokens.
local function passPoolPlan()
  local blue = game.units[game:seatOf("Blue")] or 0
  local red = game.units[game:seatOf("Red")] or 0
  local role, count = Game.passPoolFor(blue, red)
  return blue, red, role, count
end

local function phaseHeader()
  if game.phase == "setup" or game:isOver() then
    return GAME_PHASE_TITLES[game.phase]
  end
  return "ROUND " .. game.round .. " OF " .. GAME_ROUNDS .. " - " .. GAME_PHASE_TITLES[game.phase]
end

local function readyStatus()
  local lines = {}
  for _, seat in ipairs({"Blue", "Red"}) do
    local state = "waiting"
    if game.ready[seat] then
      state = game.noCard[seat] and "no card" or "READY"
    end
    table.insert(lines, seatName(seat) .. ": " .. state)
  end
  return table.concat(lines, "\n")
end

local function priorityText()
  local state = game:priorityState()
  if state.mode == "given" then
    return cardsText() .. "\n\nOnly the " .. roleName(state.role):lower()
      .. " played a card,\nso they have priority."
  elseif state.mode == "choose" then
    local why
    if game.rolled then
      why = "The blue player rolled " .. (game.rolled == "block" and "a block" or "no block")
    else
      why = "The " .. roleName(state.chooser):lower() .. " played fewer pips"
    end
    return cardsText() .. "\n\n" .. why .. ":\nthe " .. roleName(state.chooser):lower()
      .. " chooses who has priority."
  elseif state.mode == "roll" then
    local why = next(game.played) and "Same pips" or "No command cards"
    return cardsText() .. "\n\n" .. why .. ": the blue player rolls a red defense die.\n"
      .. "On a block they choose who has priority,\notherwise the red player chooses."
  end
  return cardsText() .. "\n\nThe card with fewer pips chooses who has priority.\n"
    .. "Same pips: the blue player rolls a red defense die."
end

local function passPoolText()
  local blue, red, role, count = passPoolPlan()
  local result = role and ("The " .. roleName(role):lower() .. " takes " .. plural(count, "Advantage token") .. ".")
    or "Even: no pass pool this round."
  return "Undefeated units (order tokens on the table):\n"
    .. "blue player " .. blue .. ", red player " .. red .. "\n\n"
    .. result .. "\nIs that right? Adjust the counts if not."
end

local function finalScore()
  local blue, red = Scoreboard.vp("Blue"), Scoreboard.vp("Red")
  if blue == nil or red == nil then
    return "Final scores: see the scoreboard."
  end
  local winner = Game.winner(blue, red)
  local result = winner and (roleName(winner):upper() .. " WINS") or "TIED ON VP: compare army kill points"
  return "Blue player " .. blue .. " VP, red player " .. red .. " VP\n\n" .. result
end

local function showScreen()
  local body
  if game:isOver() then
    body = finalScore()
  else
    local step = game:currentStep()
    local text = game:text(step)
    if step.id == "resolveCards" then
      text = cardsText() .. "\n\nResolve their effects, the blue player's first."
    elseif step.choice == "priority" then
      text = priorityText()
    elseif step.id == "passPool" and game.units then
      text = passPoolText()
    end
    body = step.title:upper() .. "\n\n" .. text
    if step.wait == "ready" then
      body = body .. "\n\n" .. readyStatus()
    end
  end
  printToScreen(phaseHeader() .. "\n\n" .. body, 50, 3)
end

-- What changed beyond the step (see Game:next), on the table and in chat.
local function applyChange(changed, oldPhase)
  if changed.round then
    Scoreboard.setRound(changed.round)
  end
  if changed.over then
    broadcastToAll("Game over. " .. finalScore():gsub("\n+", ". "), GAME_CHAT_COLOR)
  elseif game.phase ~= oldPhase then
    local where = game.phase == "setup" and "" or ("Round " .. game.round .. ": ")
    printToAll(where .. GAME_PHASE_TITLES[game.phase]:lower():gsub("^%l", string.upper) .. ".", GAME_CHAT_COLOR)
  end
end

local function priorityEntries(entries)
  local state = game:priorityState()
  if state.mode == "roll" then
    local tint = GAME_SEAT_TINTS[game:seatOf("Blue")]
    table.insert(entries, {functionName = "gameRollBlock", label = "Rolled a Block", tooltip = "The blue player rolled a block: they choose who has priority", buttonTint = tint})
    table.insert(entries, {functionName = "gameRollOther", label = "Rolled No Block", tooltip = "The blue player rolled a blank or a surge: the red player chooses", buttonTint = tint})
    return
  end
  for _, role in ipairs({"Blue", "Red"}) do
    if state.mode ~= "given" or state.role == role then
      table.insert(entries, {functionName = "gamePriority" .. role, label = roleName(role) .. " Has Priority", tooltip = "The " .. roleName(role) .. " (" .. game:seatOf(role) .. " seat) has priority this round", buttonTint = GAME_SEAT_TINTS[game:seatOf(role)]})
    end
  end
end

local function passPoolEntries(entries)
  if game.units == nil then
    game.units = {Blue = GameTable.countOrders("Blue"), Red = GameTable.countOrders("Red")}
  end
  local _, _, role, count = passPoolPlan()
  table.insert(entries, {functionName = "gamePassPoolConfirm", label = role and ("Right: Deal " .. count .. " Advantage") or "Right: No Pass Pool", tooltip = "The counts are right: deal the pass pool and start the Activation Phase", buttonTint = GAME_TINT})
  for _, role in ipairs({"Blue", "Red"}) do
    local seat = game:seatOf(role)
    table.insert(entries, {functionName = "gameUnitsUp" .. seat, label = roleName(role) .. ": +1 Unit", tooltip = "The " .. roleName(role) .. " has one more undefeated unit", buttonTint = GAME_SEAT_TINTS[seat]})
    table.insert(entries, {functionName = "gameUnitsDown" .. seat, label = roleName(role) .. ": -1 Unit", tooltip = "The " .. roleName(role) .. " has one fewer undefeated unit", buttonTint = GAME_SEAT_TINTS[seat]})
  end
end

function showGame()
  if game == nil then
    mainMenu()
    return
  end
  missionMenuOpen = false
  missionActingSeat = nil
  gameDrawnAt = os.clock()
  clearAllButtons()
  changeBackButton("mainMenu", "Main Menu: the game carries on, Resume Game comes back")

  local entries = {}
  if game:isOver() then
    table.insert(entries, {functionName = "gameClose", label = "Close Game", tooltip = "Back to the Main Menu", buttonTint = GAME_TINT})
  else
    local step = game:currentStep()
    if step.wait == "ready" then
      for _, seat in ipairs({"Blue", "Red"}) do
        if not game.ready[seat] then
          table.insert(entries, {functionName = "gameReady" .. seat, label = seat .. " Seat: Ready", tooltip = "Your command card is flipped face down in your hand", buttonTint = GAME_SEAT_TINTS[seat]})
          table.insert(entries, {functionName = "gameNoCard" .. seat, label = seat .. " Seat: No Card", tooltip = "You can't play a command card this round", buttonTint = GAME_SEAT_TINTS[seat]})
        end
      end
    elseif step.choice == "priority" then
      priorityEntries(entries)
    elseif step.id == "orderPool" then
      table.insert(entries, {functionName = "gameStackOrders", label = "Stack Order Tokens", tooltip = "Press STACK on both command trays, then go on", buttonTint = GAME_TINT})
      table.insert(entries, {functionName = "gameNext", label = "Already Stacked", tooltip = "Go on to the pass pool", buttonTint = GAME_TINT})
    elseif step.id == "passPool" then
      passPoolEntries(entries)
    else
      table.insert(entries, {functionName = "gameNext", label = step.next or "Next Step", tooltip = "Go on to the next step", buttonTint = GAME_TINT})
    end
  end
  createMenu(entries, 1)
  -- After createMenu, which clears it.
  if game:canGoBack() then
    changePrevButton("gameBack", "Undo the last step")
  end
  showScreen()
end

function startGame(blueSeat)
  game = Game:create({blueSeat = blueSeat})
  printToAll("Setup.", GAME_CHAT_COLOR)
  showGame()
end

function gameNext(_, playerColor)
  if game == nil or not gameClickAllowed(playerColor) then return end
  local oldPhase = game.phase
  applyChange(game:next(), oldPhase)
  showGame()
end

function gameBack()
  if game == nil or os.clock() - (gameDrawnAt or 0) < GAME_REDRAW_GUARD then return end
  local played, passPool = game.played, game.passPool
  local changed = game:back()
  if changed.round then
    Scoreboard.setRound(changed.round)
  end
  -- Undo what the undone step did on the table.
  for seat, card in pairs(played or {}) do
    if game.played[seat] == nil then GameTable.returnToHand(seat, card) end
  end
  if passPool and game.passPool == nil then
    GameTable.returnPassPool(passPool.guids)
  end
  showGame()
end

-- Both seats are ready: their cards go face up to their played spots.
local function revealCards()
  local lines = {}
  for _, role in ipairs({"Blue", "Red"}) do
    local seat = game:seatOf(role)
    local card = game.played[seat]
    if card and card.guid and not GameTable.reveal(seat, card) then
      printToAll("The " .. roleName(role):lower() .. "'s command card has left their hand: reveal it by hand.", GAME_CHAT_COLOR)
    end
    table.insert(lines, "The " .. roleName(role):lower() .. " plays " .. (playedText(role) or "no card"))
  end
  broadcastToAll(table.concat(lines, ". ") .. ".", GAME_CHAT_COLOR)
end

local function seatReady(seat, noCard, playerColor)
  if game == nil or not gameClickAllowed(playerColor) then return end
  if not mayClickFor(seat, playerColor) then return end
  local card = nil
  if not noCard then
    local cards = GameTable.faceDownCards(seat)
    if #cards == 0 then
      warn(playerColor, "Flip the command card you'll play face down in your hand first.")
      return
    elseif #cards > 1 then
      warn(playerColor, #cards .. " cards are face down in your hand: flip all but one face up.")
      return
    end
    card = GameTable.describe(cards[1])
  end
  local oldPhase = game.phase
  if game:setReady(seat, noCard, card) then
    revealCards()
    applyChange({}, oldPhase)
  end
  showGame()
end

function gameReadyBlue(_, playerColor) seatReady("Blue", false, playerColor) end
function gameReadyRed(_, playerColor) seatReady("Red", false, playerColor) end
function gameNoCardBlue(_, playerColor) seatReady("Blue", true, playerColor) end
function gameNoCardRed(_, playerColor) seatReady("Red", true, playerColor) end

local function choosePriority(role, playerColor)
  if game == nil or not gameClickAllowed(playerColor) then return end
  local step = game:currentStep()
  if step == nil or step.choice ~= "priority" then return end
  local state = game:priorityState()
  if state.mode == "choose" and not mayClickFor(game:seatOf(state.chooser), playerColor) then return end
  game:setPriority(role)
  printToAll("Round " .. game.round .. ": the " .. roleName(role):lower() .. " has priority.", GAME_CHAT_COLOR)
  showGame()
end

function gamePriorityBlue(_, playerColor) choosePriority("Blue", playerColor) end
function gamePriorityRed(_, playerColor) choosePriority("Red", playerColor) end

local function rolled(result, playerColor)
  if game == nil or not gameClickAllowed(playerColor) then return end
  local step = game:currentStep()
  if step == nil or step.choice ~= "priority" or game:priorityState().mode ~= "roll" then return end
  if not mayClickFor(game:seatOf("Blue"), playerColor) then return end
  game:setRoll(result)
  local chooser = game:priorityState().chooser
  printToAll("The blue player rolled " .. (result == "block" and "a block" or "no block")
    .. ": the " .. roleName(chooser):lower() .. " chooses who has priority.", GAME_CHAT_COLOR)
  showGame()
end

function gameRollBlock(_, playerColor) rolled("block", playerColor) end
function gameRollOther(_, playerColor) rolled("other", playerColor) end

function gameStackOrders(_, playerColor)
  if game == nil or not gameClickAllowed(playerColor) then return end
  local step = game:currentStep()
  if step == nil or step.id ~= "orderPool" then return end
  GameTable.stackOrders("Blue")
  GameTable.stackOrders("Red")
  -- Count the tokens once they're in the stacks; ignore clicks till then.
  gameDrawnAt = os.clock() + 1
  Wait.time(function()
    if game and game:currentStep() and game:currentStep().id == "orderPool" then
      game:next()
      showGame()
    end
  end, 1)
end

local function adjustUnits(seat, by, playerColor)
  if game == nil or game.units == nil or not gameClickAllowed(playerColor) then return end
  local step = game:currentStep()
  if step == nil or step.id ~= "passPool" then return end
  game.units[seat] = math.max(0, (game.units[seat] or 0) + by)
  showGame()
end

function gameUnitsUpBlue(_, playerColor) adjustUnits("Blue", 1, playerColor) end
function gameUnitsDownBlue(_, playerColor) adjustUnits("Blue", -1, playerColor) end
function gameUnitsUpRed(_, playerColor) adjustUnits("Red", 1, playerColor) end
function gameUnitsDownRed(_, playerColor) adjustUnits("Red", -1, playerColor) end

function gamePassPoolConfirm(_, playerColor)
  if game == nil or game.units == nil or not gameClickAllowed(playerColor) then return end
  local step = game:currentStep()
  if step == nil or step.id ~= "passPool" then return end
  local _, _, role, count = passPoolPlan()
  local passPool = nil
  if role then
    local seat = game:seatOf(role)
    passPool = {seat = seat, guids = GameTable.dealPassPool(seat, count)}
    printToAll("Pass pool: the " .. roleName(role):lower() .. " takes " .. plural(count, "Advantage token") .. ".", GAME_CHAT_COLOR)
  end
  local oldPhase = game.phase
  local changed = game:next()
  -- Set after the step, so going back to it takes the tokens away again.
  game.passPool = passPool
  applyChange(changed, oldPhase)
  showGame()
end

function gameClose(_, playerColor)
  if not gameClickAllowed(playerColor) then return end
  game = nil
  mainMenu()
end

-- Starting a game without the mission builder: who is the blue player?
function gameStartMenu()
  clearAllButtons()
  changeBackButton("mainMenu", "Go back to Main Menu")
  createMenu({
    {functionName = "gameStartBlueIsBlue", label = "Blue Seat: Blue Player", tooltip = "The player at the blue seat is the blue player", buttonTint = GAME_SEAT_TINTS.Blue},
    {functionName = "gameStartRedIsBlue", label = "Red Seat: Blue Player", tooltip = "The player at the red seat is the blue player", buttonTint = GAME_SEAT_TINTS.Red},
  }, 1)
  printToScreen("START GAME\n\nWho is the blue player?", 60, 3)
end

function gameStartBlueIsBlue() startGame("Blue") end
function gameStartRedIsBlue() startGame("Red") end

-- For the controller's onSave and onload.
function gameSaveState()
  return game and game:save() or nil
end

function gameLoadState(data)
  game = Game:load(data)
end
